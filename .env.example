# Docker Compose local-development values only; never reuse these in AWS.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/todo_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=todo
SPRING_DATASOURCE_PASSWORD=todo-local-password
MYSQL_ROOT_PASSWORD=todo-root-local-only

# Optional integrations. Leave empty to run CRUD without external API calls.
COHERE_API_KEY=
SLACK_WEBHOOK_URL=
CORS_ALLOWED_ORIGIN=http://localhost:3000
REACT_APP_API_BASE_URL=/api/todos

# Local Grafana login. Replace the example password before exposing Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local